# Backend env vars — set these in Render Dashboard > Environment
# (or copy to backend/.env for local development)

# Neon Postgres connection string (pooled, with -pooler hostname)
# If omitted/unset, the app falls back to a local SQLite file (data/local.db) for dev.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:9000,http://localhost:3000

# --- Ingest pipeline (app.ingest) ---
# Rate limit between HTTP requests per host (milliseconds)
INGEST_RATE_MS=1000

# LLM fallback for annual-report extraction (hybrid mode)
# Provider: Groq (recommended — free tier, OpenAI-compatible)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
INGEST_LLM_ENABLED=true
INGEST_LLM_MODEL=llama-3.3-70b-versatile
# base URL is https://api.groq.com/openai/v1 by default; override only if needed:
# INGEST_LLM_BASE_URL=https://api.groq.com/openai/v1

# Optional alternative: OpenAI instead of Groq (leave GROQ_API_KEY empty)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# INGEST_LLM_MODEL=gpt-4o-mini
